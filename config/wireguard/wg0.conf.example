[Interface]
# The IP address this device will use inside the VPN tunnel
Address = 10.0.0.2/24

# The port WireGuard listens on (must match firewall rule)
ListenPort = 51820

# The Private Key for THIS device (Generate using 'wg genkey')
PrivateKey = <YOUR_CLIENT_PRIVATE_KEY_HERE>

# DNS resolver (Optional, use if routing DNS through VPN)
# DNS = 1.1.1.1

[Peer]
# The Remote MSOC Server
PublicKey = <YOUR_SERVER_PUBLIC_KEY_HERE>

# The Server's Public IP and WireGuard Port
Endpoint = <YOUR_PUBLIC_IP_OR_DNS>:51820

# What IPs to route through the VPN?
# 0.0.0.0/0 routes ALL traffic through VPN (Maximum Security)
AllowedIPs = 0.0.0.0/0

# Keep the connection alive behind NAT/Firewalls (Send heartbeat every 25s)
PersistentKeepalive = 25