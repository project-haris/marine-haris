[Unit]
Description=Project Haris Data Collector
Wants=network-online.target signalk.service
After=network-online.target signalk.service

[Service]
Type=simple
User=haris
WorkingDirectory=/opt/haris
Environment="HARIS_VESSEL_ID=VESSEL-001"
Environment="HARIS_VESSEL_NAME=vessel"
Environment="HARIS_SIGNALK_API_URL=http://127.0.0.1:3000/signalk/v1/api/vessels/self"
Environment="HARIS_SNAPSHOT_INTERVAL=10"
Environment="HARIS_LOG_PATH=/opt/haris/logs/signalk_snapshots.jsonl"
Environment="HARIS_MAX_SIGNAL_AGE=30"
Environment="HARIS_SOC_FORWARD_ENABLED=false"
Environment="HARIS_SOC_LOG_HOST=haris-citadel"
Environment="HARIS_SOC_LOG_PORT=5045"
ExecStart=/usr/bin/python3 /opt/haris/src/data_aggregator.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
