[Unit]
Description=Marine_Haris Data Collection Daemon
Documentation=https://github.com/ahmdngi/Marine_Haris
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=haris
Group=haris
WorkingDirectory=/opt/marine_haris
ExecStart=/usr/bin/python3 /opt/marine_haris/src/data_collection/nmea2000_parser.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=harisd

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marine_haris/data
ReadOnlyPaths=/var/lib/tailscale

[Install]
WantedBy=multi-user.target